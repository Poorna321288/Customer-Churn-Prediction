   "source": [
    "pipeline = Pipeline([\n",
    "    ('scaler',      StandardScaler()),               \n",
    "    ('classifier',  FixedThresholdClassifier(       \n",
    "        estimator = xgb.XGBClassifier(...),         \n",
    "        threshold = 0.30\n",
    "    ))\n",
    "])\n",
    "\n",
    "pipeline.fit(X_train_sm, y_train_sm)              \n",
    "joblib.dump(pipeline, \"models/churn_pipeline.joblib\")"
   ]
  }
 ],
